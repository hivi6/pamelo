========================================
GRAMMAR
========================================

<prog> := <decl>+

<decl>    := <fn-decl>
<fn-decl> := FN_KEYWORD ID LPAREN RPAREN <type-specifier> <block-stmt>

<type-specifier> := ID

<stmt>        := <block-stmt> | <var-stmt> | <return-stmt> | <expr-stmt>
<block-stmt>  := LBRACE <stmt>* RBRACE
<var-stmt>    := VAR_KEYWORD ID <type-specifier>? (EQUAL <expr>)? SEMICOLON
<return-stmt> := RETURN_KEYWORD <expr>? SEMICOLON
<expr-stmt>   := <expr> SEMICOLON

<expr>         := <add-expr>
<add-expr>     := <cast-expr> ((PLUS | MINUS) <cast-expr>)*
<cast-expr>    := <postfix-expr> (AS_KEYWORD <type-specifier>)?
<postfix-expr> := <primary-expr> <postfix-op>*
<primary-expr> := <var-expr> | <literal-expr>
<var-expr>     := ID
<literal-expr> := INT_LITERAL

<postfix-op> := <call-op>
<call-op>    := LPAREN RPAREN

========================================
GRAMMAR
========================================

LBRACE    := "{"
LPAREN    := "("
RBRACE    := "}"
RPAREN    := ")"
SEMICOLON := ";"
PLUS      := "+"
MINUS     := "-"
EQUAL     := "="

INT_LITERAL := "0" 
             | "0" ("x" | "X") [a-fA-F0-9]+
             | "0" ("b" | "B") [0-1]+
             | "0" [0-7]+
             | [1-9][0-9]*

ID := [a-zA-Z_][a-zA-Z0-9_]*

FN_KEYWORD     := "fn"
AS_KEYWORD     := "as"
VAR_KEYWORD    := "var"
RETURN_KEYWORD := "return"

