========================================
GRAMMAR
========================================

<prog> := <decl>+

<decl>    := <fn-decl>
<fn-decl> := FN_KEYWORD ID LPAREN <fn-params>? RPAREN <type-specifier> 
             (EXTERN_KEYWORD SEMICOLON | <block-stmt>)

<type-specifier> := ID
<fn-params>      := ID <type-specifier> (COMMA ID <type-specifier>)*

<stmt>        := <block-stmt> | <var-stmt> | <return-stmt> | <expr-stmt>
<block-stmt>  := LBRACE <stmt>* RBRACE
<var-stmt>    := VAR_KEYWORD ID <type-specifier>? (EQUAL <expr>)? SEMICOLON
<return-stmt> := RETURN_KEYWORD <expr>? SEMICOLON
<if-stmt>     := IF_KEYWORD LPAREN <expr> RPAREN <stmt> (ELSE_KEYWORD <stmt>)?
<while-stmt>  := WHILE_KEYWORD LPAREN <expr> RPAREN <stmt>
<expr-stmt>   := <expr> SEMICOLON

<expr>         := <assign-expr>
<assign-expr>  := <equal-expr> (EQUAL <equal-expr>)?
<equal-expr>   := <add-expr> ((EQUAL_EQUAL | BANG_EQUAL) <add-expr>)*
<add-expr>     := <mul-expr> ((PLUS | MINUS) <mul-expr>)*
<mul-expr>     := <cast-expr> ((STAR | FSLASH | MOD) <cast-exor>)*
<cast-expr>    := <postfix-expr> (AS_KEYWORD <type-specifier>)?
<postfix-expr> := <primary-expr> <postfix-op>*
<primary-expr> := <var-expr> | <literal-expr>
<var-expr>     := ID
<literal-expr> := INT_LITERAL

<postfix-op> := <call-op>
<call-op>    := LPAREN <fn-args>? RPAREN
<fn-args>    := <expr> (COMMA <expr>)*

========================================
TOKEN
========================================

LBRACE    := "{"
LPAREN    := "("
RBRACE    := "}"
RPAREN    := ")"
SEMICOLON := ";"
PLUS      := "+"
MINUS     := "-"
EQUAL     := "="
COMMA     := ","
STAR      := "*"
FSLASH    := "/"
MOD       := "%"

EQUAL_EQUAL := "=="
BANG_EQUAL  := "!="

INT_LITERAL := "0" 
             | "0" ("x" | "X") [a-fA-F0-9]+
             | "0" ("b" | "B") [0-1]+
             | "0" [0-7]+
             | [1-9][0-9]*

ID := [a-zA-Z_][a-zA-Z0-9_]*

FN_KEYWORD     := "fn"
AS_KEYWORD     := "as"
VAR_KEYWORD    := "var"
RETURN_KEYWORD := "return"
EXTERN_KEYWORD := "extern"
IF_KEYWORD     := "if"
ELSE_KEYWORD   := "else"
WHILE_KEYWORD  := "while"

