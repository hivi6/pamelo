========================================
GRAMMAR
========================================

<prog> := <decl>+

<decl>    := <fn-decl>
<fn-decl> := FN_KEYWORD ID LPAREN RPAREN <type-specifier> <block-stmt>

<type-specifier> := ID

<stmt>       := <block-stmt> | <expr-stmt>
<block-stmt> := LBRACE <stmt>* RBRACE
<expr-stmt>  := <expr> SEMICOLON

<expr>         := <literal-expr>
<literal-expr> := INT_LITERAL

========================================
GRAMMAR
========================================

LBRACE    := "{"
LPAREN    := "("
RBRACE    := "}"
RPAREN    := ")"
SEMICOLON := ";"

INT_LITERAL := "0" 
             | "0" ("x" | "X") [a-fA-F0-9]+
             | "0" ("b" | "B") [0-1]+
             | "0" [0-7]+
             | [1-9][0-9]*

ID := [a-zA-Z_][a-zA-Z0-9_]*

FN_KEYWORD := "fn"

