$0: # main
@function_start
    %0 := ALLOCATE 4
    %4 := CONST 105
    STORE %0 4 := %4
    %1 := ALLOCATE 4
    %5 := CONST 9
    STORE %1 4 := %5
    %2 := ALLOCATE 4
    %6 := CONST 7
    STORE %2 4 := %6
    %7 := LOAD %0 4
    %8 := LOAD %1 4
    %9 := ADD %7 %8 4
    %10 := LOAD %2 4
    %11 := ADD %9 %10 4
    DEALLOCATE 12
    RETURN
@function_end

