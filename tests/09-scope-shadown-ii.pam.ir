// SYMBOL MEANING:
// $ = Accessing function index
// % = Accessing temp index
// # = Accessing instruction index

$0: // fn main () -> void
@function_start
    #0  | %0 := ALLOCATE 4
    #1  | %3 := CONST 1
    #2  | STORE %0 4 := %3
    #3  | %1 := ALLOCATE 4
    #4  | %4 := CONST 2
    #5  | STORE %1 4 := %4
    #6  | %5 := LOAD %1 4
    #7  | DEALLOCATE 4
    #8  | %6 := LOAD %0 4
    #9  | DEALLOCATE 4
    #10 | RETURN
@function_end

