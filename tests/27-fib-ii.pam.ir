// SYMBOL MEANING:
// $ = Accessing function index
// % = Accessing temp index
// # = Accessing instruction index

$0: // fn printNum (u32) -> void
extern

$1: // fn fib (u32) -> u32
@function_start
    #0  | %0 := GET_PARAM_ADDR 0
    #1  | %2 := GET_RETURN_ADDR
    #2  | NOP
    #3  | %3 := LOAD %0 4
    #4  | %4 := CONST 0
    #5  | %5 := LOGICAL_EQUAL %3 %4
    #6  | JUMP_TRUE %5 #8
    #7  | JUMP #12
    #8  | NOP
    #9  | %6 := CONST 0
    #10 | STORE %2 4 := %6
    #11 | RETURN
    #12 | NOP
    #13 | NOP
    #14 | %7 := LOAD %0 4
    #15 | %8 := CONST 1
    #16 | %9 := LOGICAL_EQUAL %7 %8
    #17 | JUMP_TRUE %9 #19
    #18 | JUMP #23
    #19 | NOP
    #20 | %10 := CONST 1
    #21 | STORE %2 4 := %10
    #22 | RETURN
    #23 | NOP
    #24 | %11 := LOAD %0 4
    #25 | %12 := CONST 1
    #26 | %13 := SUB %11 %12 4
    #27 | %14 := ALLOCATE 4
    #28 | STORE %14 4 := %13
    #29 | BEGIN_CALL
    #30 | SET_PARAM_ADDR 0 %14
    #31 | %15 := ALLOCATE 4
    #32 | SET_RETURN_ADDR %15
    #33 | CALL $1
    #34 | %16 := LOAD %15 4
    #35 | END_CALL
    #36 | DEALLOCATE 8
    #37 | %17 := LOAD %0 4
    #38 | %18 := CONST 2
    #39 | %19 := SUB %17 %18 4
    #40 | %20 := ALLOCATE 4
    #41 | STORE %20 4 := %19
    #42 | BEGIN_CALL
    #43 | SET_PARAM_ADDR 0 %20
    #44 | %21 := ALLOCATE 4
    #45 | SET_RETURN_ADDR %21
    #46 | CALL $1
    #47 | %22 := LOAD %21 4
    #48 | END_CALL
    #49 | DEALLOCATE 8
    #50 | %23 := ADD %16 %22 4
    #51 | STORE %2 4 := %23
    #52 | RETURN
@function_end

