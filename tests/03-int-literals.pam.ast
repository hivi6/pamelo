file: tests/03-int-literals.pam
+- AST_PROG
   +- AST_FN_DECL(type: ID | lexical: main)
      +- RETURN TYPE: AST_TYPE_SPECIFIER(type: ID | lexical: void) [void]
      +- FUNCTION BODY: AST_BLOCK_STMT
         +- AST_VAR_STMT(type: ID | lexical: a) [u32]
         |  +- AST_LITERAL_EXPR(type: INT_LITERAL | lexical: 0x69) [u32]
         +- AST_VAR_STMT(type: ID | lexical: b) [u32]
         |  +- AST_LITERAL_EXPR(type: INT_LITERAL | lexical: 0b1001) [u32]
         +- AST_VAR_STMT(type: ID | lexical: c) [u32]
         |  +- AST_LITERAL_EXPR(type: INT_LITERAL | lexical: 07) [u32]
         +- AST_EXPR_STMT
            +- AST_ADD_EXPR(type: PLUS | lexical: +) [u32]
               +- AST_ADD_EXPR(type: PLUS | lexical: +) [u32]
               |  +- AST_VAR_EXPR(type: ID | lexical: a) [u32]
               |  +- AST_VAR_EXPR(type: ID | lexical: b) [u32]
               +- AST_VAR_EXPR(type: ID | lexical: c) [u32]

