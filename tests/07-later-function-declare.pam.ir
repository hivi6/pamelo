$0: # fn main () -> void
@function_start
    BEGIN_CALL
    %1 := ALLOCATE 4
    SET_RETURN_ADDR %1
    CALL $1
    %2 := LOAD %1 4
    END_CALL
    DEALLOCATE 4
    RETURN
@function_end

$1: # fn value () -> u32
@function_start
    %1 := GET_RETURN_ADDR
    %2 := CONST 42
    STORE %1 4 := %2
    RETURN
@function_end

