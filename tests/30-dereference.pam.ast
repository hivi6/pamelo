         |     +- AST_LITERAL_EXPR(type: INT_LITERAL | lexical: 10) [u32]
         +- AST_EXPR_STMT
         |  +- AST_CALL_EXPR [void]
         |     +- AST_VAR_EXPR(type: ID | lexical: printNum) [fn printNum (u32) -> void]
         |     +- ARG 1: AST_VAR_EXPR(type: ID | lexical: a) [u64]
         +- AST_EXPR_STMT
         |  +- AST_ASSIGN_EXPR(type: EQUAL | lexical: =) [u64]
         |     +- AST_VAR_EXPR(type: ID | lexical: a) [u64]
         |     +- AST_LITERAL_EXPR(type: INT_LITERAL | lexical: 17) [u32]
         +- AST_EXPR_STMT
            +- AST_CALL_EXPR [void]
               +- AST_VAR_EXPR(type: ID | lexical: printNum) [fn printNum (u32) -> void]
               +- ARG 1: AST_DEREFERENCE_EXPR [u64]
