// SYMBOL MEANING:
// $ = Accessing function index
// % = Accessing temp index
// # = Accessing instruction index

$0: // fn add (u32, u32) -> u32
@function_start
    #0 | %0 := GET_PARAM_ADDR 0
    #1 | %1 := GET_PARAM_ADDR 1
    #2 | %3 := GET_RETURN_ADDR
    #3 | %4 := LOAD %0 4
    #4 | %5 := LOAD %1 4
    #5 | %6 := ADD %4 %5 4
    #6 | STORE %3 4 := %6
    #7 | RETURN
@function_end

$1: // fn main () -> void
@function_start
    #0  | %1 := CONST 19
    #1  | %2 := ALLOCATE 4
    #2  | STORE %2 4 := %1
    #3  | %3 := CONST 50
    #4  | %4 := ALLOCATE 4
    #5  | STORE %4 4 := %3
    #6  | BEGIN_CALL
    #7  | SET_PARAM_ADDR 0 %2
    #8  | SET_PARAM_ADDR 1 %4
    #9  | %5 := ALLOCATE 4
    #10 | SET_RETURN_ADDR %5
    #11 | CALL $0
    #12 | %6 := LOAD %5 4
    #13 | END_CALL
    #14 | DEALLOCATE 12
    #15 | RETURN
@function_end

