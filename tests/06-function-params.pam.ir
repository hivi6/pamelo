$0: # add
@function_start
    %0 := GET_PARAM_ADDR 0
    %1 := GET_PARAM_ADDR 1
    %3 := GET_RETURN_ADDR
    %4 := LOAD %0 4
    %5 := LOAD %1 4
    %6 := ADD %4 %5 4
    STORE %3 4 := %6
    RETURN
@function_end

$1: # main
@function_start
    BEGIN_CALL
    %1 := CONST 19
    %2 := ALLOCATE 4
    STORE %2 4 := %1
    SET_PARAM_ADDR 0 %2
    %3 := CONST 50
    %4 := ALLOCATE 4
    STORE %4 4 := %3
    SET_PARAM_ADDR 1 %4
    %5 := ALLOCATE 4
    SET_RETURN_ADDR %5
    CALL $0
    %6 := LOAD %5 4
    DEALLOCATE 12
    END_CALL
    RETURN
@function_end

