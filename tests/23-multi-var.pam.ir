// SYMBOL MEANING:
// $ = Accessing function index
// % = Accessing temp index
// # = Accessing instruction index

$0: // fn printNum (u32) -> void
extern

$1: // fn f (u32) -> void
@function_start
    #0  | %0 := GET_PARAM_ADDR 0
    #1  | %3 := LOAD %0 4
    #2  | %4 := ALLOCATE 4
    #3  | STORE %4 4 := %3
    #4  | BEGIN_CALL
    #5  | SET_PARAM_ADDR 0 %4
    #6  | CALL $0
    #7  | END_CALL
    #8  | DEALLOCATE 4
    #9  | %1 := ALLOCATE 4
    #10 | %5 := CONST 12
    #11 | STORE %1 4 := %5
    #12 | %6 := LOAD %1 4
    #13 | %7 := ALLOCATE 4
    #14 | STORE %7 4 := %6
    #15 | BEGIN_CALL
    #16 | SET_PARAM_ADDR 0 %7
    #17 | CALL $0
    #18 | END_CALL
    #19 | DEALLOCATE 4
    #20 | DEALLOCATE 4
    #21 | RETURN
@function_end

$2: // fn main () -> void
@function_start
    #0  | %1 := CONST 10
    #1  | %2 := ALLOCATE 4
    #2  | STORE %2 4 := %1
    #3  | BEGIN_CALL
    #4  | SET_PARAM_ADDR 0 %2
    #5  | CALL $1
    #6  | END_CALL
    #7  | DEALLOCATE 4
    #8  | RETURN
@function_end

