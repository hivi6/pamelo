$0: # fn printNum (u32) -> void
extern

$1: # fn f (u32) -> void
@function_start
    %0 := GET_PARAM_ADDR 0
    %3 := LOAD %0 4
    %4 := ALLOCATE 4
    STORE %4 4 := %3
    BEGIN_CALL
    SET_PARAM_ADDR 0 %4
    CALL $0
    END_CALL
    DEALLOCATE 4
    %1 := ALLOCATE 4
    %5 := CONST 12
    STORE %1 4 := %5
    %6 := LOAD %1 4
    %7 := ALLOCATE 4
    STORE %7 4 := %6
    BEGIN_CALL
    SET_PARAM_ADDR 0 %7
    CALL $0
    END_CALL
    DEALLOCATE 4
    DEALLOCATE 4
    RETURN
@function_end

$2: # fn main () -> void
@function_start
    %1 := CONST 10
    %2 := ALLOCATE 4
    STORE %2 4 := %1
    BEGIN_CALL
    SET_PARAM_ADDR 0 %2
    CALL $1
    END_CALL
    DEALLOCATE 4
    RETURN
@function_end

