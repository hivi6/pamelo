// SYMBOL MEANING:
// $ = Accessing function index
// % = Accessing temp index
// # = Accessing instruction index

$0: // fn printNum (u32) -> void
extern

$1: // fn main () -> void
@function_start
    #0  | NOP
    #1  | %1 := CONST 1
    #2  | %2 := CONST 0
    #3  | %3 := LOGICAL_EQUAL %1 %2
    #4  | JUMP_TRUE %3 #6
    #5  | JUMP #15
    #6  | NOP
    #7  | %4 := CONST 420
    #8  | %5 := ALLOCATE 4
    #9  | STORE %5 4 := %4
    #10 | BEGIN_CALL
    #11 | SET_PARAM_ADDR 0 %5
    #12 | CALL $0
    #13 | END_CALL
    #14 | DEALLOCATE 4
    #15 | NOP
    #16 | RETURN
@function_end

