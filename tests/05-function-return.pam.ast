file: tests/05-function-return.pam
+- AST_PROG
   +- AST_FN_DECL(type: ID | lexical: value)
   |  +- RETURN TYPE: AST_TYPE_SPECIFIER(type: ID | lexical: u32) [u32]
   |  +- FUNCTION BODY: AST_BLOCK_STMT
   |     +- AST_RETURN_STMT
   |        +- AST_LITERAL_EXPR(type: INT_LITERAL | lexical: 42) [u32]
   +- AST_FN_DECL(type: ID | lexical: main)
      +- RETURN TYPE: AST_TYPE_SPECIFIER(type: ID | lexical: void) [void]
      +- FUNCTION BODY: AST_BLOCK_STMT
         +- AST_EXPR_STMT
            +- AST_CALL_EXPR [u32]
               +- AST_VAR_EXPR(type: ID | lexical: value) [fn value () -> u32]

