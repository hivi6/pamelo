// SYMBOL MEANING:
// $ = Accessing function index
// % = Accessing temp index
// # = Accessing instruction index

$0: // fn value () -> u32
@function_start
    #0 | %1 := GET_RETURN_ADDR
    #1 | %2 := CONST 42
    #2 | STORE %1 4 := %2
    #3 | RETURN
@function_end

$1: // fn main () -> void
@function_start
    #0 | BEGIN_CALL
    #1 | %1 := ALLOCATE 4
    #2 | SET_RETURN_ADDR %1
    #3 | CALL $0
    #4 | %2 := LOAD %1 4
    #5 | END_CALL
    #6 | DEALLOCATE 4
    #7 | RETURN
@function_end

